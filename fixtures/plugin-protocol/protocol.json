{
  "envelopes": [
    {
      "name": "request-with-params",
      "kind": "request",
      "method": "fs.readText",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"fs.readText\",\"params\":{\"path\":\"C:/repo/notes/a.md\"}}"
    },
    {
      "name": "request-null-params",
      "kind": "request",
      "method": "state.read",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"state.read\"}"
    },
    {
      "name": "view-register-request",
      "kind": "request",
      "method": "view.register",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"view.register\",\"params\":{\"id\":\"com.atelyx.llama.models\",\"label\":\"模型\",\"slot\":\"panel\"}}"
    },
    {
      "name": "view-takeover-request",
      "kind": "request",
      "method": "view.takeover",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"view.takeover\",\"params\":{\"scope\":\"full\",\"surfaceId\":\"main\"}}"
    },
    {
      "name": "window-closed-notification",
      "kind": "notification",
      "method": "host:window.closed",
      "line": "{\"jsonrpc\":\"2.0\",\"method\":\"host:window.closed\",\"params\":{\"id\":\"chat-float\"}}"
    },
    {
      "name": "notification",
      "kind": "notification",
      "method": "host:event",
      "line": "{\"jsonrpc\":\"2.0\",\"method\":\"host:event\",\"params\":{\"name\":\"vault:switch\",\"payload\":{\"kind\":\"local\",\"root\":\"C:/repo\"}}}"
    },
    {
      "name": "response-success",
      "kind": "response",
      "method": null,
      "line": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"content\":\"# A\"}}"
    },
    {
      "name": "response-error",
      "kind": "response",
      "method": null,
      "line": "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32001,\"message\":\"能力未声明：fs.readText\"}}"
    }
  ],
  "viewTree": {
    "id": "root",
    "kind": "column",
    "gap": 8.0,
    "padding": 12.0,
    "crossAlign": "start",
    "children": [
      {
        "id": "title",
        "kind": "text",
        "content": "模型管理",
        "size": 15.0,
        "weight": "semiBold",
        "color": "text"
      },
      {
        "id": "query",
        "kind": "textInput",
        "value": "示例文本",
        "placeholder": "输入…",
        "events": ["submit"]
      },
      {
        "id": "size",
        "kind": "numberInput",
        "min": 1.0,
        "max": 100.0,
        "step": 1.0,
        "events": ["change"]
      },
      {
        "id": "engine",
        "kind": "dropdown",
        "options": ["a", "b"],
        "selected": 0,
        "events": ["change"]
      },
      {
        "id": "flag",
        "kind": "checkbox",
        "checked": true,
        "label": "自动启动",
        "events": ["change"]
      },
      {
        "id": "tools",
        "kind": "row",
        "gap": 6.0,
        "align": "center",
        "crossAlign": "center",
        "children": [
          {
            "id": "shot",
            "kind": "iconButton",
            "icon": "camera",
            "tooltip": "截图",
            "events": ["click"]
          },
          {
            "id": "go",
            "kind": "button",
            "label": "开始",
            "variant": "primary",
            "events": ["click"]
          },
          {
            "id": "load",
            "kind": "progress",
            "value": 0.4
          }
        ]
      },
      {
        "id": "paneGrid",
        "kind": "grid",
        "columns": 2,
        "gap": 6.0,
        "children": [
          {
            "id": "last",
            "kind": "image",
            "source": { "type": "private", "path": "shots/last.png" },
            "fit": "contain"
          },
          {
            "id": "more",
            "kind": "menu",
            "label": "更多",
            "icon": "ellipsis",
            "items": [
              { "label": "重载", "action": "reload" },
              { "label": "清除", "action": "purge", "danger": true }
            ],
            "events": ["change"]
          }
        ]
      },
      {
        "id": "scroller",
        "kind": "scroll",
        "direction": "vertical",
        "children": [
          {
            "id": "log",
            "kind": "list",
            "children": [
              { "id": "log1", "kind": "text", "content": "已加载" },
              { "id": "log2", "kind": "text", "content": "就绪", "color": "textMuted" }
            ]
          }
        ]
      },
      {
        "id": "board",
        "kind": "canvas",
        "mouseEvents": ["pointerDown", "pointerMove", "pointerUp", "pointerLeave", "wheel", "doubleClick"]
      },
      {
        "id": "titleDrag",
        "kind": "dragRegion"
      }
    ]
  },
  "handshake": {
    "params": {
      "apiVersion": 1,
      "plugin": { "id": "com.atelyx.echo", "name": "Echo", "version": "0.1.0" }
    },
    "result": {
      "apiVersion": 1,
      "host": { "name": "Atelyx", "version": "0.6.0" }
    }
  },
  "manifest": {
    "id": "com.example.studio",
    "name": "Studio",
    "version": "1.2.0",
    "apiVersion": 1,
    "entry": { "windows": "bin/studio.exe", "linux": "bin/studio" },
    "permissions": ["fs", "process", "notification"],
    "singleton": true,
    "keepMountedOnVaultSwitch": false,
    "docTypeRegistrations": [
      { "extension": "board", "label": "画板", "icon": "layout-dashboard", "surface": "board-view" }
    ]
  },
  "methods": [
    {
      "name": "fs.readText params",
      "type": "PathParams",
      "value": { "path": "C:/repo/notes/a.md" }
    },
    {
      "name": "fs.list result",
      "type": "ListResult",
      "value": { "entries": [ { "name": "a.md", "kind": "file" }, { "name": "sub", "kind": "dir" } ] }
    },
    {
      "name": "process.spawn params",
      "type": "SpawnParams",
      "value": { "program": "sample-service", "args": ["--port", "8080"], "cwd": "C:/svc", "env": { "A": "1" } }
    },
    {
      "name": "process event",
      "type": "ProcessEventParams",
      "value": { "pid": 42, "event": { "kind": "stdout", "data": "ok" } }
    },
    {
      "name": "notification.show params",
      "type": "ShowNotificationParams",
      "value": { "title": "完成", "body": "已退出", "level": "success" }
    },
    {
      "name": "shortcut.register params",
      "type": "RegisterShortcutParams",
      "value": { "accelerator": "Shift+Alt+E" }
    },
    {
      "name": "clipboard payload",
      "type": "TextPayload",
      "value": { "text": "x" }
    },
    {
      "name": "dialog.pickFile params",
      "type": "PickFileParams",
      "value": { "title": "选择", "save": false, "defaultPath": "C:/a", "filters": [ { "name": "PNG", "extensions": ["png"] } ] }
    },
    {
      "name": "dialog.pickFile result",
      "type": "PickedPath",
      "value": { "path": "C:/a/b.png" }
    },
    {
      "name": "http.request params",
      "type": "HttpRequestParams",
      "value": { "method": "GET", "url": "http://127.0.0.1:8188", "headers": { "A": "b" }, "timeoutMs": 5000 }
    },
    {
      "name": "http.request result",
      "type": "HttpResult",
      "value": { "status": 200, "headers": { "Content-Type": "application/json" }, "bodyBase64": "e30=" }
    },
    {
      "name": "view.register params (panel registration)",
      "type": "RegisterParams",
      "value": { "slot": "panel", "id": "com.atelyx.llama.models", "label": "模型", "icon": "box" }
    },
    {
      "name": "view.register params (tableView slot, icon omitted)",
      "type": "RegisterParams",
      "value": { "slot": "tableView", "id": "com.atelyx.table.timeline", "label": "时间线" }
    },
    {
      "name": "view.unregister params",
      "type": "UnregisterParams",
      "value": { "id": "com.atelyx.llama.models" }
    },
    {
      "name": "view surface attached",
      "type": "SurfaceAttachedParams",
      "value": { "surfaceId": "main", "kind": "panel" }
    },
    {
      "name": "view event params",
      "type": "ViewEventParams",
      "value": { "surfaceId": "main", "nodeId": "go", "event": { "kind": "change", "value": "start" } }
    },
    {
      "name": "doc.open params",
      "type": "DocOpenParams",
      "value": { "path": "docs/board", "surfaceId": "doc:1" }
    },
    {
      "name": "doc.close params",
      "type": "DocCloseParams",
      "value": { "path": "docs/board", "surfaceId": "doc:1" }
    },
    {
      "name": "view.takeover params",
      "type": "TakeoverParams",
      "value": { "scope": "page", "surfaceId": "main" }
    },
    {
      "name": "window.open params",
      "type": "WindowOpenParams",
      "value": { "id": "chat-float", "title": "快捷对话", "width": 360.0, "height": 480.0, "alwaysOnTop": true, "skipTaskbar": true, "hideOnBlur": true }
    },
    {
      "name": "window.close params",
      "type": "WindowCloseParams",
      "value": { "id": "chat-float" }
    },
    {
      "name": "window.closed params",
      "type": "WindowClosedParams",
      "value": { "id": "chat-float" }
    },
    {
      "name": "service.register params",
      "type": "ServiceRegisterParams",
      "value": { "contract": "webSearch" }
    },
    {
      "name": "search.query params",
      "type": "SearchQueryParams",
      "value": { "requestId": 7, "query": "rust iced" }
    },
    {
      "name": "search.respond params",
      "type": "SearchRespondParams",
      "value": {
        "requestId": 7,
        "results": [ { "title": "iced", "url": "https://iced.rs", "snippet": "A cross-platform GUI library" } ]
      }
    },
    {
      "name": "vault:switch payload (local)",
      "type": "VaultSwitchPayload",
      "value": { "kind": "local", "root": "C:/repo" }
    },
    {
      "name": "vault:switch payload (space)",
      "type": "VaultSwitchPayload",
      "value": { "kind": "space", "spaceId": "space-1" }
    },
    {
      "name": "canvas.submit params",
      "type": "CanvasSubmitParams",
      "value": {
        "surfaceId": "panel",
        "nodeId": "board",
        "commands": [
          { "kind": "line", "x1": 0.0, "y1": 0.5, "x2": 10.0, "y2": 0.5, "stroke": { "type": "token", "name": "accent" }, "width": 2.0 },
          { "kind": "rect", "x": 1.0, "y": 2.0, "w": 8.0, "h": 4.0, "fill": null, "stroke": { "type": "rgba", "rgba": [200, 64, 64, 255] }, "strokeWidth": 1.5, "cornerRadius": 2.0 },
          { "kind": "path", "points": [ { "x": 0.0, "y": 0.0 }, { "x": 4.5, "y": 5.0 }, { "x": 9.0, "y": 0.0 } ], "closed": true, "fill": { "type": "token", "name": "success" }, "stroke": null },
          { "kind": "circle", "cx": 5.0, "cy": 5.0, "r": 3.0, "fill": null, "stroke": { "type": "token", "name": "textMuted" } },
          { "kind": "text", "x": 1.0, "y": 1.0, "content": "播放头", "size": 12.0, "color": { "type": "token", "name": "text" }, "weight": "medium" },
          { "kind": "image", "source": { "type": "vault", "path": "assets/tile.png" }, "x": 0.0, "y": 0.0, "w": 16.0, "h": 16.0 }
        ]
      }
    },
    {
      "name": "view event canvas pointer",
      "type": "ViewEventParams",
      "value": {
        "surfaceId": "panel",
        "nodeId": "board",
        "event": { "kind": "canvas", "pointer": { "kind": "down", "x": 12.5, "y": 3.0, "button": "left" } }
      }
    },
    {
      "name": "view event canvas wheel",
      "type": "ViewEventParams",
      "value": {
        "surfaceId": "panel",
        "nodeId": "board",
        "event": { "kind": "canvas", "pointer": { "kind": "wheel", "x": 8.0, "y": 8.0, "deltaX": 0.0, "deltaY": 1.0 } }
      }
    },
    {
      "name": "view event canvas double click",
      "type": "ViewEventParams",
      "value": {
        "surfaceId": "panel",
        "nodeId": "board",
        "event": { "kind": "canvas", "pointer": { "kind": "doubleClick", "x": 8.0, "y": 8.0, "button": "left" } }
      }
    }
  ]
}
