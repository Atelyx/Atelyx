{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelyx",
  "version": "0.5.9",
  "identifier": "com.atelyx.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Atelyx",
        "width": 1440,
        "height": 900,
        "minWidth": 1440,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#131418",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' http: https:; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; connect-src 'self' http: https: ws: wss: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' blob: 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"]
      }
    },
    "resources": ["resources/esbuild", "resources/runtime"]
  },
  "plugins": {
    "shell": {
      "open": "(?:https?://|file://|mailto:|tel:|xmpp:|[A-Za-z]:[\\\\/]|\\\\\\\\|/).*"
    }
  }
}
