{
  "id": "atelyx.tables",
  "name": "表格",
  "version": "0.1.0",
  "apiVersion": 1,
  "entry": {
    "windows": "atelyx_plugin_tables.dll",
    "linux": "libatelyx_plugin_tables.so"
  },
  "permissions": ["vault", "collab", "fs", "dialog", "clipboard", "notification"],
  "singleton": true,
  "keepMountedOnVaultSwitch": false,
  "docTypeRegistrations": [
    {
      "id": "table",
      "extensions": ["atb"],
      "ownerPlugin": "atelyx.tables",
      "views": ["table"],
      "editable": true,
      "multiDoc": false,
      "label": "表格",
      "icon": "table"
    }
  ]
}
