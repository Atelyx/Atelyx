{
  "name": "atelyx",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "description": "一款可拓展的桌面 AI 工作台：对话、笔记、表格、文件同台使用，AI 辅助贯穿，局域网多人协作",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "build:vendor": "tsc -b vendor/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run build:vendor && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
