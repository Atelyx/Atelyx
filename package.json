{
  "name": "atelyx",
  "private": true,
  "version": "0.5.9",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "description": "一款可拓展的桌面 AI 工作台：对话、笔记、表格、文件同台使用，AI 辅助贯穿，局域网多人协作",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/sync-esbuild.mjs && node scripts/sync-node-runtime.mjs && tauri dev",
    "tauri:build": "node scripts/sync-esbuild.mjs && node scripts/sync-node-runtime.mjs && tauri build",
    "typecheck": "tsc --noEmit",
    "build:vendor": "tsc -b vendor/tsconfig.json",
    "ctx-api": "node scripts/gen-ctx-api.mjs",
    "ctx-api:check": "node scripts/gen-ctx-api.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path atelyx-server/Cargo.toml",
    "android:16kb": "node scripts/check-android-16kb.mjs",
    "check": "pnpm run build:vendor && pnpm run typecheck && pnpm run ctx-api:check && pnpm run lint && pnpm run test && pnpm run test:rust"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@standard-schema/spec": "^1.1.0",
    "@tauri-apps/api": "~2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@xyflow/react": "^12.11.2",
    "dompurify": "^3.4.14",
    "esbuild-wasm": "^0.28.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.11",
    "lib0": "^0.2.117",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
